{:paths ["src" "resources"]
 :jolt/min-version "0.8.24"
 ;; The jolt the tasks build and test on: jolt-lang/jolt's main at the merge of
 ;; #1580, which added System/mapLibraryName (the tasks need it when jolt runs
 ;; them); the first release with it can replace this commit. The minimum stays
 ;; 0.8.24, the first release champaca itself needs.
 :champaca/jolt {:git/url "https://github.com/jolt-lang/jolt.git"
                 :git/sha "3db8a5343ebacfe8596bec8fa872f471f2673f84"}
 :aliases
 {;; Code metrics report (jolt metrics): jolt-metrics' CLI. Report only.
  :metrics {:extra-deps {io.github.jlt-commons/jolt-metrics
                         {:git/url "https://github.com/jlt-commons/jolt-metrics"
                          :git/tag "v0.2.2" :git/sha "8568d4c"}}
            :main-opts ["-m" "metrics.cli"]}}}
