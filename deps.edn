{:paths ["src" "resources"]
 :jolt/min-version "0.8.24"
 ;; The jolt the tasks build and test on: the v0.8.26 tag, the first release
 ;; with System/mapLibraryName (#1580), which the tasks need when jolt runs
 ;; them. The minimum stays 0.8.24, the first release champaca itself needs.
 :champaca/jolt {:git/url "https://github.com/jolt-lang/jolt.git"
                 :git/sha "84008f560276b9a417c9bab0f0421ae90bdcdf17"}
 :aliases
 {;; Code metrics report (jolt metrics): jolt-metrics' CLI. Report only.
  :metrics {:extra-deps {io.github.jlt-commons/jolt-metrics
                         {:git/url "https://github.com/jlt-commons/jolt-metrics"
                          :git/tag "v0.2.2" :git/sha "8568d4c"}}
            :main-opts ["-m" "metrics.cli"]}}}
