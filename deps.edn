{:paths ["src" "resources"]
 :jolt/min-version "0.8.24"
 ;; The jolt the tasks build and test on: the v0.8.27 tag. The tasks need
 ;; 0.8.26 or later (System/mapLibraryName, #1580, when jolt runs them);
 ;; 0.8.27 adds jolt.ffi/stack-args-correct? (#1632), which foreign.ss asks
 ;; before making a call Chez 10.4.1 would misplace. The minimum stays
 ;; 0.8.24, the first release champaca itself needs.
 :champaca/jolt {:git/url "https://github.com/jolt-lang/jolt.git"
                 :git/sha "0f08ec2732a0078d7523f274a1507049c06bffe6"}
 :aliases
 {;; Code metrics report (jolt metrics): jolt-metrics' CLI. Report only.
  :metrics {:extra-deps {io.github.jlt-commons/jolt-metrics
                         {:git/url "https://github.com/jlt-commons/jolt-metrics"
                          :git/tag "v0.4.0" :git/sha "e51804d"}}
            :main-opts ["-m" "metrics.cli"]}}}
