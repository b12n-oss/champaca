(defun row (k v) (format t "~a: ~s~%" k v))
(defstruct point x y)
(defclass animal () ((name :initarg :name :reader name)))
(defclass dog (animal) ())
(defgeneric speak (a))
(defmethod speak ((a animal)) (format nil "~a makes a sound" (name a)))
(defmethod speak ((d dog)) (format nil "~a says woof" (name d)))
(defmacro my-unless (c &body b) `(if ,c nil (progn ,@b)))
(defun fact (n) (if (<= n 1) 1 (* n (fact (1- n)))))
(defun fib (n) (if (< n 2) n (+ (fib (- n 1)) (fib (- n 2)))))
(compile 'fib)
(row "arith" (list (+ 1 2) (/ 1 3) (* 1.5 2) (floor 17 5) (mod -17 5) (expt 2 100) (sqrt 16.0) (logxor 12 10)))
(row "fact" (fact 25))
(row "compiled fib" (fib 20))
(row "lists" (list (mapcar #'1+ '(1 2 3)) (remove-if #'evenp '(1 2 3 4 5)) (reduce #'+ '(1 2 3 4)) (sort (list 3 1 2) #'<) (append '(1) '(2 3)) (reverse '(1 2 3))))
(row "loop" (loop for i from 1 to 10 when (evenp i) collect (* i i)))
(row "strings" (list (string-upcase "abc") (concatenate 'string "a" "b") (subseq "hello" 1 3) (format nil "~5,2f|~x|~r" 3.14159 255 42) (search "lo" "hello")))
(row "hash" (let ((h (make-hash-table :test 'equal))) (setf (gethash "a" h) 1 (gethash "b" h) 2) (sort (loop for k being the hash-keys of h collect k) #'string<)))
(row "struct" (let ((p (make-point :x 1 :y 2))) (list (point-x p) (point-p p))))
(row "clos" (list (speak (make-instance 'animal :name "cat")) (speak (make-instance 'dog :name "rex"))))
(row "macro" (list (my-unless nil :ran) (macroexpand-1 '(my-unless x y))))
(row "closures" (let ((c 0)) (let ((inc (lambda () (incf c)))) (funcall inc) (funcall inc) c)))
(row "conditions" (handler-case (error "boom ~a" 7) (error (e) (format nil "~a" e))))
(row "restart" (restart-case (invoke-restart 'use 5) (use (v) (* v 2))))
(row "multiple values" (multiple-value-list (floor 7 2)))
(row "characters" (list (char-code #\A) (code-char 98) (char-upcase #\z)))
(row "vectors" (let ((v (make-array 3 :initial-contents '(3 1 2)))) (sort v #'<)))
(row "java" (list (java:jcall "toUpperCase" "java") (java:jstatic "abs" "java.lang.Math" -5)))
(row "eval" (eval '(let ((x 6)) (* x 7))))
(row "symbols" (list (symbol-name 'foo) (intern "BAR") (keywordp :k)))
(row "bignum" (* 99999999999 99999999999))
(row "ratio" (+ 1/3 1/6))
(row "float" (list (float 1/3) (coerce 1/4 'double-float)))
