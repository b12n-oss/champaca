(import (srfi 1) (srfi 69))
(define (row k v) (display k) (display ": ") (write v) (newline))
(define (fact n) (if (<= n 1) 1 (* n (fact (- n 1)))))
(define-record-type point (make-point x y) point? (x point-x) (y point-y))
(define-syntax my-unless (syntax-rules () ((_ c body ...) (if c #f (begin body ...)))))
(row "arith" (list (+ 1 2) (/ 1 3) (* 1.5 2) (quotient 17 5) (modulo -17 5) (expt 2 100) (sqrt 16) (exact->inexact 1/3)))
(row "fact" (fact 25))
(row "lists" (list (map (lambda (x) (+ x 1)) '(1 2 3)) (filter odd? '(1 2 3 4 5)) (apply + '(1 2 3 4)) (reverse '(1 2 3)) (assoc 'b '((a 1) (b 2)))))
(row "strings" (list (string-upcase "abc") (string-append "a" "b") (substring "hello" 1 3) (string-length "héllo") (number->string 255 16)))
(row "chars" (list (char->integer #\A) (integer->char 98) (char-upcase #\z)))
(row "vectors" (let ((v (vector 3 1 2))) (vector-set! v 0 9) v))
(row "record" (let ((p (make-point 1 2))) (list (point-x p) (point? p))))
(row "macro" (my-unless #f 'ran))
(row "closures" (let ((c 0)) (let ((inc (lambda () (set! c (+ c 1)) c))) (inc) (inc))))
(row "tail calls" (let loop ((i 0) (acc 0)) (if (= i 100000) acc (loop (+ i 1) (+ acc i)))))
(row "call/cc" (+ 1 (call-with-current-continuation (lambda (k) (k 41)))))
(row "values" (call-with-values (lambda () (values 1 2 3)) list))
(row "let-values" (let-values (((q r) (floor/ 17 5))) (list q r)))
(row "hash" (let ((h (make-hash-table))) (hash-table-set! h 'a 1) (hash-table-ref/default h 'a 0)))
(row "java" (list ((java.lang.String "java"):toUpperCase) (java.lang.Math:abs -5)))
(row "exceptions" (guard (e (#t (error-object-message e))) (error "boom" 7)))
(row "eval" (eval '(* 6 7) (interaction-environment)))
(row "bignum" (* 99999999999 99999999999))
(row "dynamic-wind" (let ((log '())) (dynamic-wind (lambda () (set! log (cons 'in log))) (lambda () 'body) (lambda () (set! log (cons 'out log)))) (reverse log)))
