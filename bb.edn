{:tasks
 {:requires ([babashka.fs :as fs] [babashka.process :as process] [clojure.string :as str] [clojure.edn :as edn] [clojure.java.io :as io])
  :init (do
          ;; deps.edn :champaca/jolt pins an upstream jolt commit; `jolt jolt` builds
          ;; it to ~/.cache/champaca/jolt/<sha>/jolt from a jolt checkout
          ;; ($JOLT_SRC, default ~/dev/jolt) through a detached worktree.
          (def jolt-pin (:champaca/jolt (edn/read-string (slurp "deps.edn"))))
          (def jolt-dir (str (System/getenv "HOME") "/.cache/champaca/jolt/" (subs (:git/sha jolt-pin) 0 8)))
          (def jolt-pinned (str jolt-dir "/jolt"))
          ;; the task runner tasks that start another task use: bb under bb, and
          ;; under jolt (which reads bb.edn too) the pinned jolt once built, since a
          ;; machine that only built it (the Linux container) has no jolt on PATH
          (def runner (cond (System/getProperty "babashka.version") "bb"
                            (fs/executable? jolt-pinned) jolt-pinned
                            :else "jolt"))
          ;; $JOLT wins, then the pinned build, then jolt on PATH
          (defn jolt-bin []
            (or (System/getenv "JOLT") (when (fs/executable? jolt-pinned) jolt-pinned) "jolt"))
          ;; a command with a time limit, so a test that hangs fails instead.
          ;; A hang leaves its output so far, and on macOS a native stack
          ;; sample, in target/hangs/<program>-<ms>/, the program being opts'
          ;; :label or else the command's last word.
          (defn run-limited [secs opts & cmd]
            (let [outf (str (fs/create-temp-file {:prefix "champaca-out-"}))
                  label (or (:label opts) (fs/file-name (last cmd)))
                  proc (apply process/process (merge {:out (fs/file outf) :err :inherit :in :inherit} (dissoc opts :label)) cmd)
                  r (deref proc (* 1000 secs) :timed-out)]
              (try
                (if (= r :timed-out)
                  (let [d (str "target/hangs/" label "-" (System/currentTimeMillis))]
                    (fs/create-dirs d)
                    (when (fs/which "sample")
                      (shell {:continue true :out (str d "/sample.txt") :err :string} "sample" (str (.pid (:proc proc))) "5"))
                    (fs/copy outf (str d "/partial.out"))
                    (process/destroy-tree proc)
                    (println (str "timed out after " secs " s; output so far and a stack sample in " d))
                    {:out "" :exit 124})
                  (assoc r :out (slurp outf)))
                (finally (fs/delete-if-exists outf)))))
          ;; test/libs: a Maven coordinate's path in a repository, and a file's SHA-1
          (defn m2-path [coord]
            (let [[g a v] (str/split coord (re-pattern ":"))]
              (str (str/replace g "." "/") "/" a "/" v "/" a "-" v ".jar")))
          (defn m2-jar [coord] (str (System/getenv "HOME") "/.m2/repository/" (m2-path coord)))
          ;; a file's digest in hex through openssl (macOS and Linux both have it):
          ;; jolt has no java.security.MessageDigest provider of its own, so
          ;; this keeps the tasks the same under bb and jolt
          (defn file-digest [algo f]
            (first (str/split (str/trim (:out (shell {:out :string} "openssl" "dgst" (str "-" algo) "-r" (str f))))
                              (re-pattern " "))))
          ;; ci/linux: the image's architecture, and building it
          (defn linux-arch [given]
            (let [arch (or given (if (re-find (re-pattern "arm64|aarch64") (str/trim (:out (shell {:out :string} "uname -m")))) "arm64" "amd64"))]
              (when-not (contains? #{"arm64" "amd64"} arch)
                (println (str "jolt linux: the architecture is arm64 or amd64, not " arch))
                (System/exit 1))
              arch))
          ;; the pinned OpenJDK 25.0.2 per architecture: the one place its checksums live
          (defn linux-image! [arch]
            (let [[a sha] (case arch
                            "arm64" ["aarch64" "671208d205e70c9805da45a483f670d49dd64654990a7b7223ccffb2abb070dd"]
                            "amd64" ["x64" "555ce0821e4fe175ea50d54518cd6fbece9663c1998de529bc6ce429534457df"])
                  file (str "openjdk-25.0.2_linux-" a "_bin.tar.gz")
                  f (str "ci/linux/cache/" file)]
              (when-not (fs/exists? f)
                (fs/create-dirs "ci/linux/cache")
                ;; some proxies refuse download.java.net; a direct connection works
                (shell {:env (apply dissoc (into {} (System/getenv)) ["HTTPS_PROXY" "https_proxy" "HTTP_PROXY" "http_proxy"])}
                       "curl -fsSL --retry 2 -o" (str f ".part")
                       (str "https://download.java.net/java/GA/jdk25.0.2/b1e0dfa218384cb9959bdcb897162d4e/10/GPL/openjdk-25.0.2_linux-" a "_bin.tar.gz"))
                (fs/move (str f ".part") f {:replace-existing true}))
              (let [got (file-digest "sha256" f)]
                (when-not (= got sha)
                  (fs/delete f)
                  (println "REFUSED" f ": SHA-256" got "is not the pinned" sha)
                  (System/exit 1)))
              (shell "docker build --platform" (str "linux/" arch) "--build-arg" (str "JDK_FILE=" file)
                     "--build-arg" (str "JDK_SHA256=" sha) "-t" (str "champaca-linux:" arch) "ci/linux")))
          ;; the jolt programs in examples/, each with what it shows; each is a
          ;; namespace of tests that jolt test and jolt example run
          (def examples [["interop" "jolt calling Java"] ["dynamic" "descriptor-free calls"]
                         ["varargs" "varargs and vectors as arrays"]
                         ["jars" "a jar and other JDK modules"]
                         ["collections" "jolt collections as java.util and back"]
                         ["callsite" "the call-site cache"]
                         ["jolt-after-init" "jolt itself still works after init!"]
                         ["threads" "Java threads started from jolt"]
                         ["files" "files and MessageDigest from jolt"]
                         ["fields" "Java fields read and written from jolt"]
                         ["serialization" "Java serialization of the program's own classes from jolt"]
                         ["proxy" "java.lang.reflect.Proxy from jolt, and jolt errors through Java"]
                         ["classes" "real Java classes defined from jolt"]
                         ["preview" "class files compiled with --enable-preview, from jolt"]
                         ["vector" "the Vector API, with :add-modules, from jolt"]
                         ["upcalls" "C calling jolt fns through upcall stubs"]])
          ;; test/jar packed into target/lib.jar, which jars, fields,
          ;; serialization and classes put on their classpath
          (defn lib-jar! []
            (shell "mkdir -p target/lib-classes")
            (apply shell "javac -Xlint:-removal -d target/lib-classes" (map str (fs/glob "test/jar" "**.java")))
            ;; and its other files: a service registration, a properties file
            (doseq [f (fs/glob "test/jar" "**")
                    :when (and (fs/regular-file? f) (not (str/ends-with? (str f) ".java")))
                    :let [to (fs/path "target/lib-classes" (str (fs/relativize "test/jar" f)))]]
              (fs/create-dirs (fs/parent to))
              (fs/copy f to {:replace-existing true}))
            ;; with a manifest of its own: a package section, a wrapped value
            (shell "jar cfm target/lib.jar test/jar.mf -C target/lib-classes ."))
          (defn lib-jar-stale? []
            (or (not (fs/exists? "target/lib.jar"))
                (seq (fs/modified-since "target/lib.jar" ["test/jar" "test/jar.mf"]))))
          ;; The docs site is rendered by jlt-commons/docs-engine, which lives
          ;; in its own repo. site:* tasks delegate to it. Found via
          ;; $JLT_DOCS_ENGINE (or the older $DOCS_ENGINE), then
          ;; ~/dev/jlt-commons/docs-engine, then a sibling checkout.
          (def docs-engine-repo "https://github.com/jlt-commons/docs-engine")
          (defn docs-engine-dir []
            (let [home (System/getProperty "user.home")]
              (->> [(System/getenv "JLT_DOCS_ENGINE")
                    (System/getenv "DOCS_ENGINE")
                    (str home "/dev/jlt-commons/docs-engine")
                    "../docs-engine"]
                   (remove nil?)
                   (filter (fn [d] (fs/exists? (fs/file d "bb.edn"))))
                   first)))
          (defn site-task [task & args]
            (if-let [engine (docs-engine-dir)]
              ;; jolt names its own commands build, run and so on: jolt run <task>
              ;; reaches the engine's task of that name
              (let [argv (into (if (= runner "bb") [runner task] [runner "run" task])
                               (cons (str (fs/canonicalize ".")) (remove nil? args)))
                    ;; HTTPS_PROXY cleared: the engine fetches markdown-clj on first run.
                    res (apply process/shell {:dir (str engine) :continue true
                                              :extra-env {"HTTPS_PROXY" "" "https_proxy" ""}} argv)]
                (when-not (zero? (:exit res)) (System/exit (:exit res))))
              (do
                (println "The docs engine is not checked out anywhere I looked:")
                (println "  $JLT_DOCS_ENGINE, $DOCS_ENGINE, ~/dev/jlt-commons/docs-engine, ../docs-engine")
                (println)
                (println (str "  git clone " docs-engine-repo " ~/dev/jlt-commons/docs-engine"))
                (System/exit 1))))
          ;; The attempt IS the test: bind the wildcard address without
          ;; SO_REUSEADDR, so a port held on any interface counts as busy (a
          ;; loopback-only bind would coexist with another process's wildcard
          ;; bind and the server would land beside it, silently).
          (defn can-bind? [p]
            (let [s (java.net.ServerSocket.)]
              (.setReuseAddress s false)
              (try (.bind s (java.net.InetSocketAddress. (int p)))
                   true
                   (catch Exception _ false)
                   (finally (.close s)))))
          (defn free-port [base span]
            (loop [p base]
              (when (<= p (+ base span))
                (if (can-bind? p) p (recur (inc p))))))
          ;; something accepts connections on this loopback port
          (defn port-answers? [port]
            (try (with-open [s (java.net.Socket.)]
                   (.connect s (java.net.InetSocketAddress. "127.0.0.1" (int port)) 500)
                   true)
                 (catch Exception _ false)))
          (defn port-file-port [f]
            (when (fs/exists? f) (parse-long (str/trim (slurp f)))))
          (defn sha1-hex [f] (file-digest "sha1" f)))
  jolt {:doc "Build the jolt commit pinned in deps.edn (:champaca/jolt) to ~/.cache/champaca/jolt/<sha8>/jolt (tools/build-jolt.sh, which needs no jolt to run)"
        :task (shell "sh tools/build-jolt.sh")}
  test {:doc "javac test/java/*.java, run each main class through the JIT, diff against <Name>.expected; the same for upstream OpenLDK's test/aaa programs; then the examples/*.clj tests"
        :task (let [_ (println "jolt:" (jolt-bin) (str/trim (:out (shell {:out :string} (jolt-bin) "--version"))))
                    ;; every translator source must be in main.clj's translator-sources, or
                    ;; editing it would leave the startup cache key unchanged
                    _ (let [text (slurp "src/champaca/main.clj")
                            start (str/index-of text "(def ^:private translator-sources")
                            listed (subs text start (str/index-of text "]" start))
                            unlisted (->> (fs/glob "src/champaca" "*.clj")
                                          (map (fn [f] (str (fs/file-name f))))
                                          (remove (fn [n] (contains? (set ["api.clj" "npe.clj"]) n)))
                                          (remove (fn [n] (str/includes? listed (str "\"champaca/" n "\""))))
                                          sort)]
                        (when (seq unlisted)
                          (println "bb test: src/champaca files missing from translator-sources in main.clj (the startup cache key would ignore edits to them):" (str/join ", " unlisted))
                          (System/exit 1)))
                    _ (shell "mkdir -p target/classes")
                    ;; test/jar is packed into target/lib.jar, so its classes reach
                    ;; the runtime only from a jar on the classpath
                    _ (lib-jar!)
                    ;; a second jar sharing one package with the first (PackageCheck)
                    _ (shell "mkdir -p target/lib2-classes")
                    _ (apply shell "javac -Xlint:-removal -d target/lib2-classes" (map str (fs/glob "test/jar2" "**.java")))
                    _ (shell "jar cfm target/lib2.jar test/jar2.mf -C target/lib2-classes .")
                    srcs (map str (fs/glob "test/java" "*.java"))
                    _ (apply shell "javac -parameters -Xlint:-removal -cp target/lib.jar:target/lib2.jar -d target/classes" srcs)
                    ;; IndyCheck calls bootstraps of its own, which javac can't emit
                    _ (shell "java test/gen/IndyCheckGen.java target/classes")
                    ;; DefaultConflictCheck's classes conflict only at run time, which javac refuses
                    _ (shell "java test/gen/DefaultConflictGen.java target/classes")
                    ;; ModuleCheck's Truncated.class: present but unloadable
                    _ (shell "java test/gen/TruncatedGen.java target/classes")
                    _ (shell "java test/gen/NoMethodGen.java target/classes")
                    ;; ClassFormatCheck's broken class files and the class reaching them
                    _ (shell "java test/gen/ClassFormatGen.java target/classes")
                    ;; OldConcat: a concatenation handed an array and a null raw, as javac before 19 emits
                    _ (shell "java test/gen/OldConcatGen.java target/classes")
                    ;; IcceCheck's IcCaller: calls of the wrong kind (invokevirtual of a static method...)
                    _ (shell "java test/gen/IcceGen.java target/classes")
                    ;; ClassDefCheck's classes the JVM refuses to define (a final superclass...)
                    _ (shell "java test/gen/ClassDefGen.java target/classes")
                    ;; SealedCheck's sealed classes and the subclasses the JVM refuses
                    _ (shell "java test/gen/SealedGen.java target/classes")
                    ;; CondyCheck's CondyUser: entries ldc'd from several methods, bootstraps that fail
                    _ (shell "java test/gen/CondyGen.java target/classes")
                    ;; SiteLinkCheck's SiteMemberLambda: a lambda whose implementation method doesn't exist
                    _ (shell "java test/gen/SiteMemberGen.java target/classes")
                    ;; LongOpsCheck's LongCmp: lcmp returned, kept in a local, branched on in another block
                    _ (shell "java test/gen/LongCmpGen.java target/classes")
                    ;; ArrayLoopCheck's ArrayLoopShapes: arrays moved by dup_x1 and swap in a loop
                    _ (shell "java test/gen/ArrayLoopGen.java target/classes")
                    ;; VersionCheck's class files of every version, which javac can't write
                    _ (shell "java test/gen/VersionGen.java target/classes")
                    ;; PreviewCheck uses JDK 25's preview features: javac writes it as
                    ;; 69.65535 with --enable-preview, which the other sources must not get
                    _ (apply shell "javac --release 25 --enable-preview -Xlint:-preview -cp target/classes -d target/classes"
                             (map str (fs/glob "test/preview" "*.java")))
                    ;; VectorCheck uses jdk.incubator.vector, outside the default
                    ;; module graph: javac needs --add-modules, as the run does
                    ;; (VectorCheck.options)
                    _ (apply shell "javac --add-modules jdk.incubator.vector -Xlint:-incubating -d target/classes"
                             (map str (fs/glob "test/vector" "*.java")))
                    ;; run as -jar: target/app.jar's manifest names JarMain and a
                    ;; Class-Path of lib.jar beside it
                    _ (shell "mkdir -p target/jarmain-classes")
                    _ (shell "javac -d target/jarmain-classes test/jarmain/JarMain.java")
                    _ (shell "jar cfm target/app.jar test/jarmain.mf -C target/jarmain-classes .")
                    ;; ForeignCheck's and UpcallCheck's native library, loaded through
                    ;; SymbolLookup.libraryLookup and System.loadLibrary
                    _ (shell (str "cc -shared -fPIC -O1 -pthread -o target/" (System/mapLibraryName "ffitest") " test/native/ffitest.c"))
                    _ (shell (str "cc -shared -fPIC -O1 -o target/" (System/mapLibraryName "jnibad") " test/native/jnibad.c"))
                    ;; BlockingIoCheck's FIFO
                    _ (fs/delete-if-exists "target/blocking-io.fifo")
                    _ (shell "mkfifo target/blocking-io.fifo")
                    mains (->> (fs/glob "test/java" "*.expected")
                               (map (fn [p] (str/replace (fs/file-name p) ".expected" "")))
                               sort)
                    fails (doall
                           (for [m mains
                                 :let [stdin (str "test/java/" m ".stdin")
                                       ;; launcher options, one per line, before the class path
                                       opts-file (str "test/java/" m ".options")
                                       opts (if (fs/exists? opts-file) (remove str/blank? (str/split-lines (slurp opts-file))) [])
                                       {:keys [out exit]} (apply run-limited 300 (cond-> {:extra-env {"CHAMPACA_NPE_STRICT" "1" "CHAMPACA_TEST_VAR" "a=b=c"}}
                                                                                   (fs/exists? stdin) (assoc :in (fs/file stdin)))
                                                                 (jolt-bin) "-M" "-m" "champaca.main"
                                                                 (concat opts ["target/classes:target/lib.jar:target/lib2.jar" m]))
                                       ok (and (zero? exit) (= out (slurp (str "test/java/" m ".expected"))))]]
                             (do (println (if ok "PASS" "FAIL") m)
                                 ;; a failing program's output is kept under target/fails/ and
                                 ;; the start of its diff printed, so a CI log says what differed
                                 (when-not ok
                                   (let [actual (str "target/fails/" m ".out")]
                                     (fs/create-dirs "target/fails")
                                     (spit actual out)
                                     (println "  exit" exit)
                                     (let [d (:out (process/sh "diff" "-u" (str "test/java/" m ".expected") actual))]
                                       (doseq [l (take 40 (str/split-lines (or d "")))] (println " " l)))))
                                 (when-not ok m))))
                    jar-fails (let [{:keys [out exit]} (run-limited 300 {:label "jarmain"} (jolt-bin) "-M" "-m" "champaca.main" "-jar" "target/app.jar" "a" "b")
                                    ok (and (zero? exit) (= out (slurp "test/jarmain/JarMain.expected")))]
                                (println (if ok "PASS" "FAIL") "-jar target/app.jar (test/jarmain)")
                                (if ok [] ["-jar"]))
                    ;; launcher options: -D before -jar, an option java doesn't know, the
                    ;; ignored ones, -cp and its spellings, and the accepted ones
                    opt-fails (let [{:keys [out exit]} (run-limited 300 {:label "jarmain-opts"} (jolt-bin) "-M" "-m" "champaca.main"
                                                                    "-Dchampaca.test.plain=bar" "-jar" "target/app.jar" "a" "b")
                                    jar-ok (and (zero? exit) (= out (slurp "test/jarmain/JarMain.expected")))
                                    {:keys [err exit]} (run-limited 300 {:label "bad-option" :err :string} (jolt-bin) "-M" "-m" "champaca.main"
                                                                    "-Dchampaca.test.plain=bar" "-Xbogus" "target/classes" "Hello")
                                    bad-ok (and (= 1 exit) (str/starts-with? err "Unrecognized option: -Xbogus\n"))
                                    {:keys [out err exit]} (run-limited 300 {:label "ignored-options" :err :string} (jolt-bin) "-M" "-m" "champaca.main"
                                                                    "-Xmx512m" "-XX:+UseG1GC" "-verbose:gc" "-verbose" "-Xlog:gc" "-Xint" "-Xrs" "-Xverify:none"
                                                                    "target/classes" "Hello")
                                    ignored-ok (and (zero? exit) (= out (slurp "test/java/Hello.expected"))
                                                    (= err (apply str (map (fn [o] (str "champaca: ignoring option " o "; it has no counterpart here\n"))
                                                                           ["-Xmx512m" "-XX:+UseG1GC" "-verbose:gc" "-verbose" "-Xlog:gc" "-Xint" "-Xrs" "-Xverify:none"]))))
                                    ;; -version and its kin print what the JDK's VersionProps
                                    ;; does, so the first two lines are this JDK's own (java
                                    ;; -version's), the third champaca's VM; -version and
                                    ;; --version exit, -showversion and --show-version run main
                                    hs-version (str/split-lines (:err (process/sh "java" "-version")))
                                    hs-version2 (str/split-lines (:out (process/sh "java" "--version")))
                                    vm-line "champaca (build 0.0-spike, compiled mode)\n"
                                    version (fn [& args] (apply run-limited 300 {:label "version" :err :string} (jolt-bin) "-M" "-m" "champaca.main" args))
                                    err-text (str (hs-version 0) "\n" (hs-version 1) "\n" vm-line)
                                    out-text (str (hs-version2 0) "\n" (hs-version2 1) "\n" vm-line)
                                    version-ok (and (let [{:keys [out err exit]} (version "-version")] (and (zero? exit) (= out "") (= err err-text)))
                                                    (let [{:keys [out err exit]} (version "--version" "-cp" "target/classes" "Hello")]
                                                      (and (zero? exit) (= out out-text) (= err "")))
                                                    (let [{:keys [out err exit]} (version "-showversion" "target/classes" "Hello")]
                                                      (and (zero? exit) (= out (slurp "test/java/Hello.expected")) (= err err-text)))
                                                    (let [{:keys [out err exit]} (version "--show-version" "-cp" "target/classes" "Hello")]
                                                      (and (zero? exit) (= out (str out-text (slurp "test/java/Hello.expected"))) (= err "")))
                                                    ;; java.c's order: nothing after -version is read, a
                                                    ;; -- form before it means stdout; -Xdiag is silent
                                                    (let [{:keys [out err exit]} (version "-version" "-showversion" "-bogus" "target/classes" "Hello")]
                                                      (and (zero? exit) (= out "") (= err err-text)))
                                                    (let [{:keys [out err exit]} (version "--show-version" "-version")] (and (zero? exit) (= out out-text) (= err "")))
                                                    (let [{:keys [out err exit]} (version "-version" "--version")] (and (zero? exit) (= out "") (= err err-text)))
                                                    (let [{:keys [out err exit]} (version "--show-version" "-showversion" "-Xdiag" "target/classes" "Hello")]
                                                      (and (zero? exit) (= out (str out-text (slurp "test/java/Hello.expected"))) (= err "")))
                                                    (let [{:keys [out err exit]} (version "-showversion")]
                                                      (and (= 2 exit) (= out "") (str/starts-with? err (str err-text "usage: jolt")))))
                                    ;; -cp and its spellings take the main class first; a dir/*
                                    ;; entry is the jars in it; -jar ignores -cp, as java does
                                    _ (fs/delete-tree "target/wild")
                                    _ (fs/create-dirs "target/wild")
                                    _ (doseq [j ["lib.jar" "lib2.jar"]] (fs/copy (str "target/" j) (str "target/wild/" j)))
                                    _ (spit "target/wild/notes.txt" "not a jar\n")
                                    ;; a dir/* that finds no jar stays as written, so a
                                    ;; directory really named * is searched
                                    _ (fs/create-dirs "target/wild/star/*")
                                    _ (fs/copy "target/classes/Hello.class" "target/wild/star/*/Hello.class")
                                    {:keys [out exit]} (run-limited 300 {:label "cp-star-dir"} (jolt-bin) "-M" "-m" "champaca.main"
                                                                    "-cp" "target/wild/none/*:target/wild/star/*" "Hello")
                                    star-ok (and (zero? exit) (= out (slurp "test/java/Hello.expected")))
                                    jar-check (slurp "test/java/JarCheck.expected")
                                    cp-ok (every? (fn [args]
                                                    (let [{:keys [out exit]} (apply run-limited 300 {:label "cp-option"} (jolt-bin) "-M" "-m" "champaca.main" args)]
                                                      (and (zero? exit) (= out jar-check))))
                                                  [["-cp" "target/classes:target/lib.jar:target/lib2.jar" "JarCheck"]
                                                   ["--class-path=nothere" "-classpath" "target/classes:target/wild/*" "JarCheck"]])
                                    {:keys [err exit]} (run-limited 300 {:label "cp-missing" :err :string} (jolt-bin) "-M" "-m" "champaca.main" "-cp")
                                    cp-missing-ok (and (= 1 exit) (= err "Error: -cp requires class path specification\n"))
                                    {:keys [out exit]} (run-limited 300 {:label "cp-jar"} (jolt-bin) "-M" "-m" "champaca.main"
                                                                    "-cp" "nothere" "-jar" "target/app.jar" "a" "b")
                                    cp-jar-ok (and (zero? exit) (= out (slurp "test/jarmain/JarMain.expected")))
                                    {:keys [out err exit]} (run-limited 300 {:label "accepted-options" :err :string} (jolt-bin) "-M" "-m" "champaca.main"
                                                                    "-server" "-client" "-Xshare:auto" "target/classes" "Hello")
                                    accepted-ok (and (zero? exit) (= out (slurp "test/java/Hello.expected"))
                                                     (= err "champaca: ignoring option -Xshare:auto; it has no counterpart here\n"))
                                    ;; -Xss bounds the stack, with HotSpot's checks: 0 is the default,
                                    ;; under 208k too small, over 1g too large, a bad size invalid
                                    xss (fn [o] (run-limited 300 {:label "xss" :err :string} (jolt-bin) "-M" "-m" "champaca.main" o "target/classes" "Hello"))
                                    xss-ok (and (let [{:keys [out exit]} (xss "-Xss0")] (and (zero? exit) (= out (slurp "test/java/Hello.expected"))))
                                                (let [{:keys [out exit]} (xss "-Xss512k")] (and (zero? exit) (= out (slurp "test/java/Hello.expected"))))
