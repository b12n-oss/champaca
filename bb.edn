                        (shell (str "javac -d " lc "/" v "-classes test/libcache/" v "/lc/Base.java")))
                    _ (when-not (apply = (map (fn [v] (fs/size (str lc "/" v "-classes/lc/Base.class"))) ["v1" "v3"]))
                        (println "jolt test: lc/Base.class sizes differ between v1 and v3, so test/libcache doesn't check the CRC")
                        (System/exit 1))
                    _ (shell (str "javac -cp " lc "/v1-classes -d " lc "/sub-classes test/libcache/lc/Sub.java"))
                    _ (doseq [v ["v1" "v2"]]
                        (shell (str "jar cf " lc "/base-" v ".jar -C " lc "/" v "-classes . -C " lc "/sub-classes .")))
                    _ (shell (str "javac -cp " lc "/v1-classes:" lc "/sub-classes -d " lc "/user-classes test/libcache/lc2/User.java"))
                    _ (shell (str "jar cf " lc "/user.jar -C " lc "/user-classes ."))
                    _ (shell (str "javac -cp " lc "/user.jar:" lc "/base-v1.jar -d " lc "/main-classes test/libcache/LibCacheMain.java"))
                    sub-crcs (set (for [v ["v1" "v2"]]
                                    (with-open [z (java.util.zip.ZipFile. (str lc "/base-" v ".jar"))]
                                      (.getCrc (.getEntry z "lc/Sub.class")))))
                    _ (when-not (= 1 (count sub-crcs))
                        (println "jolt test: lc/Sub.class differs between base-v1.jar and base-v2.jar, so test/libcache checks nothing")
                        (System/exit 1))
                    cache-on (not= "off" (System/getenv "CHAMPACA_CACHE"))
                    ;; each run: the jar, the expected output, and how many classes
                    ;; at least come from the cache. The last run gets Base back
                    ;; from base-v1.jar's own library file, kept while base-v2.jar
                    ;; ran, plus User's registration
                    libcache-fails (->> [["base-v1.jar" "v1" 0] ["base-v1.jar" "v1" 1] ["base-v2.jar" "v2" 0] ["base-v2.jar" "v2" 1]
                                         ;; Base from a directory ahead of the jar, cached by its bytes
                                         ;; as a jar's class is by its CRC: LibCacheMain, Base, Sub and
                                         ;; User all come back on the second run
                                         ["v2-classes:" "v2dir" 0 "base-v1.jar"] ["v2-classes:" "v2dir" 4 "base-v1.jar"]
                                         ["base-v1.jar" "v1" 2]
                                         ;; one path rebuilt, as a snapshot or an uberjar is: base.jar is
                                         ;; v1, then v2 copied over it, which its own library file must
                                         ;; not answer with v1's classes
                                         ["base.jar" "v1base" 0 nil "base-v1.jar"] ["base.jar" "v1base" 1]
                                         ["base.jar" "v2base" 0 nil "base-v2.jar"]
                                         ;; and one directory rebuilt, as javac -d does: v1's classes,
                                         ;; then v2's over them
                                         ["base-dir" "v1basedir" 0 nil ["v1-classes" "sub-classes"]] ["base-dir" "v1basedir" 4]
                                         ;; v3 is v1 at the same size with another CRC
                                         ["base-dir" "v3basedir" 0 nil ["v3-classes"]]
                                         ["base-dir" "v2basedir" 0 nil ["v2-classes" "sub-classes"]]]
                                        (map-indexed
                                         (fn [i [first-entry v restores second-entry copy-from]]
                                           (let [_ (cond (vector? copy-from)
                                                         (doseq [d copy-from]
                                                           (fs/copy-tree (str lc "/" d) (str lc "/base-dir") {:replace-existing true}))
                                                         copy-from
                                                         (fs/copy (str lc "/" copy-from) (str lc "/base.jar") {:replace-existing true}))
                                                 cp (str lc "/main-classes:" lc "/" first-entry
                                                         (when second-entry (str lc "/" second-entry)) ":" lc "/user.jar")
                                                 ;; CHAMPACA_STATS prints after boot, then at exit: the last counts.
                                                 ;; The output has a jar class's frame with its line: CHAMPACA_LINES=all
                                                 ;; (its own cache key, so the first row boots cold)
                                                 {:keys [out err exit]} (run-limited 300 {:label (str "libcache-" (inc i)) :err :string
                                                                                          :extra-env {"CHAMPACA_NPE_STRICT" "1" "CHAMPACA_STATS" "1" "CHAMPACA_LINES" "all"}}
                                                                                     (jolt-bin) "-M" "-m" "champaca.main" cp "LibCacheMain")
                                                 restored (some-> (re-seq (re-pattern "\\((\\d+) from the library cache\\)") (str err)) last second parse-long)
                                                 ok (and (zero? exit) (= out (slurp (str "test/libcache/" v ".expected")))
                                                         (or (not cache-on) (>= (or restored 0) restores)))
                                                 what (str "test/libcache run " (inc i) " (" cp (when (pos? restores) (str ", at least " restores " from the cache")) ")")]
                                             (println (if ok "PASS" "FAIL") what)
                                             (when-not ok
                                               (println (str "  exit " exit ", out " (pr-str out) ", restored " restored))
                                               (when-not (zero? exit) (print err) (flush)))
                                             (when-not ok (str "libcache-" (inc i))))))
                                        doall
                                        (remove nil?)
                                        vec)
                    ;; without CHAMPACA_LINES a jar class's frame has no line number (-1,
                    ;; as a JDK frame's): the first libcache run again, on jolt test's own
                    ;; key, against v1's output with the line number -1
                    ;; the same with the cache off (the methods compile without recording:
                    ;; the same rule), and StackCheck's directory classes with
                    ;; CHAMPACA_LINES=off: champaca's own output, not the JVM's, since
                    ;; besides every line being -1 an inlined leaf that throws from a
                    ;; check shows its caller's frame (limitations.md); under CHAMPACA_BT=1
                    ;; the shadow-stack wrappers keep that frame, so the -bt file is the
                    ;; same output with those five frames in place
                    nolines-fails (let [cp (str lc "/main-classes:" lc "/base-v1.jar:" lc "/user.jar")
                                        row (fn [label env args expected what]
                                              (let [{:keys [out exit]} (apply run-limited 300 {:label label :extra-env (merge {"CHAMPACA_NPE_STRICT" "1"} env)}
                                                                              (jolt-bin) "-M" "-m" "champaca.main" args)
                                                    expected (if (string? expected) [expected] expected)
                                                    ok (and (zero? exit) (some (fn [f] (= out (slurp f))) expected))]
                                                (println (if ok "PASS" "FAIL") what)
                                                (when-not ok (println (str "  exit " exit ", out " (pr-str out))))
                                                (when-not ok label)))]
                                    (->> [(row "libcache-nolines" {} [cp "LibCacheMain"] "test/libcache/v1nolines.expected"
                                               "a jar class's frame has no line number without CHAMPACA_LINES")
                                          (row "libcache-nolines-cache-off" {"CHAMPACA_CACHE" "off"} [cp "LibCacheMain"] "test/libcache/v1nolines.expected"
                                               "the same with CHAMPACA_CACHE=off")
                                          (row "stackcheck-lines-off" {"CHAMPACA_LINES" "off"} ["target/classes:target/lib.jar:target/lib2.jar" "StackCheck"]
                                               (if (System/getenv "CHAMPACA_BT") ["test/libcache/StackCheck-lines-off-bt.expected"] ["test/libcache/StackCheck-lines-off.expected"])
                                               "StackCheck's own frames have no line numbers with CHAMPACA_LINES=off")]
                                         (remove nil?)
                                         vec))
                    ;; a lambda over a jar's interface that gains a default method
                    ;; (test/libcache/lam): the main for v2 calls it, the second v2
                    ;; run with the lambda's class from the cache
                    _ (doseq [v ["v1" "v2"]]
                        (shell (str "javac -d " lc "/lam-" v "-classes test/libcache/lam/" v "/li/Greeter.java"))
                        (shell (str "jar cf " lc "/greeter-" v ".jar -C " lc "/lam-" v "-classes ."))
                        (shell (str "javac -cp " lc "/greeter-" v ".jar -d " lc "/lam-main-" v " test/libcache/lam/m" (subs v 1) "/LamMain.java")))
                    ;; then the interface from a directory, and from one
                    ;; directory holding v1's interface, then v2's over it
                    lam-fails (->> [["v1" ".jar"] ["v2" ".jar"] ["v2" ".jar"] ["v1" "-dir"] ["v2" "-dir"] ["v2" "-dir"]
                                    ["v1" "-same"] ["v2" "-same"]]
                                   (map-indexed
                                    (fn [i [v kind]]
                                      (let [_ (when (= kind "-same")
                                                (fs/copy-tree (str lc "/lam-" v "-classes") (str lc "/lam-same") {:replace-existing true}))
                                            cp (str lc "/lam-main-" v ":" lc (case kind ".jar" (str "/greeter-" v ".jar") "-dir" (str "/lam-" v "-classes") "/lam-same"))
                                            {:keys [out exit]} (run-limited 300 {:label (str "libcache-lam-" (inc i)) :extra-env {"CHAMPACA_NPE_STRICT" "1"}}
                                                                            (jolt-bin) "-M" "-m" "champaca.main" cp "LamMain")
                                            ok (and (zero? exit) (= out (slurp (str "test/libcache/lam/" v ".expected"))))]
                                        (println (if ok "PASS" "FAIL") (str "test/libcache/lam run " (inc i) " (" cp ")"))
                                        (when-not ok (str "libcache-lam-" (inc i))))))
                                   doall
                                   (remove nil?)
                                   vec)
                    ;; a directory's class restored from the cache, its file
                    ;; replaced mid-run before a method the cache lacks compiles
                    ;; (test/libcache/edit): that method is the version the class
                    ;; was restored as, then the next run takes the new file
                    _ (shell (str "javac -d " lc "/edit-classes test/libcache/edit/v1/Q.java test/libcache/edit/EditMain.java"))
                    _ (shell (str "javac -d " lc "/edit-q2 test/libcache/edit/v2/Q.java"))
                    edit-fails (->> [[] [(str lc "/edit-q2/Q.class") (str lc "/edit-classes/Q.class")] []]
                                    (map-indexed
                                     (fn [i args]
                                       (let [{:keys [out err exit]} (apply run-limited 300 {:label (str "libcache-edit-" (inc i)) :err :string
                                                                                            :extra-env {"CHAMPACA_NPE_STRICT" "1"}}
                                                                           (jolt-bin) "-M" "-m" "champaca.main" (str lc "/edit-classes") "EditMain" args)
                                             ok (and (zero? exit) (= out (slurp (str "test/libcache/edit/" (inc i) ".expected"))))]
                                         (println (if ok "PASS" "FAIL") (str "test/libcache/edit run " (inc i)))
                                         (when-not ok
                                           (println (str "  exit " exit ", out " (pr-str out)))
                                           (when-not (zero? exit) (print err) (flush)))
                                         (when-not ok (str "libcache-edit-" (inc i))))))
                                    doall
                                    (remove nil?)
                                    vec)
                    ;; classes a loader of the program's own defines (test/libcache/def):
                    ;; cached by their bytes, and a change to B makes A's cached methods,
                    ;; which read B, compile again
                    _ (shell (str "javac -d " lc "/def-main test/libcache/def/DefMain.java"))
                    _ (shell (str "javac -d " lc "/def-v1 test/libcache/def/v1/d/A.java test/libcache/def/v1/d/B.java test/libcache/def/v1/d/F.java test/libcache/def/v1/d/S.java"
                                  " test/libcache/def/v1/Gen.java test/libcache/def/v1/A2.java"))
                    _ (doseq [v ["v2" "v3"]]
                        (fs/create-dirs (str lc "/def-" v "/d"))
                        (shell (str "javac -d " lc "/def-" v " test/libcache/def/" v "/d/B.java test/libcache/def/" v "/d/F.java test/libcache/def/" v "/d/S.java"))
                        ;; A and A2 as compiled against v1, as a jar built earlier would hold them
                        (fs/copy (str lc "/def-v1/d/A.class") (str lc "/def-" v "/d/A.class") {:replace-existing true})
                        (fs/copy (str lc "/def-v1/A2.class") (str lc "/def-" v "/A2.class") {:replace-existing true}))
                    _ (shell (str "javac -d " lc "/def-v2 test/libcache/def/v2/Gen.java"))
                    _ (shell (str "javac -d " lc "/def-sealed test/libcache/def/sealed/d2/CS.java test/libcache/def/sealed/d2/CQ.java"))
                    def-fails (->> [["def-v1" "v1" 0 nil] ["def-v1" "v1" 6 0] ["def-v2" "v2" 5 10] ["def-v2" "v2all" 6 10 "all"] ["def-v1" "v1" 5 10]
                                    ["def-v3" "v3" 4 30] ["def-v1" "v1" 4 30] ["def-v1" "v1" 6 0]
                                    ["def-v2" "v2other" 5 10 "other-first"] ["def-v2" "v2other" 6 0 "other-first"]
                                    ["def-v1" "v1gen" 0 nil "gen"] ["def-v2" "v2gen" 0 nil "gen"]
                                    ;; a sealed class's subclass restored from the cache is still checked
                                    ["def-sealed" "sealed" 0 nil "sealed"] ["def-sealed" "sealed" 2 nil "sealed"]
                                    ["def-sealed" "sealed-split" 0 nil "sealed-split"]]
                                   (map-indexed
                                    (fn [i [dir v restores compiles & more]]
                                      (let [{:keys [out err exit]} (apply run-limited 300 {:label (str "libcache-def-" (inc i)) :err :string
                                                                                           :extra-env {"CHAMPACA_NPE_STRICT" "1" "CHAMPACA_STATS" "1"}}
                                                                                (jolt-bin) "-M" "-m" "champaca.main" (str lc "/def-main") "DefMain" (str lc "/" dir) more)
                                            restored (some-> (re-seq (re-pattern "\\((\\d+) from the library cache\\)") (str err)) last second parse-long)
                                            ;; a repeat run compiles nothing: A's cached methods hold, the
                                            ;; lambda over F included; after a change to B they compile again
                                            compiled (some-> (re-seq (re-pattern "(\\d+) methods compiled") (str err)) last second parse-long)
                                            ok (and (zero? exit) (= out (slurp (str "test/libcache/def/" v ".expected")))
                                                    (or (not cache-on) (and (>= (or restored 0) restores)
                                                                            (or (nil? compiles) (<= (or compiled 999) compiles)))))]
                                        (println (if ok "PASS" "FAIL") (str "test/libcache/def run " (inc i) " (" dir (when (pos? restores) (str ", at least " restores " from the cache"))
                                                                              (when compiles (str ", at most " compiles " methods compiled")) ")"))
                                        (when-not ok
                                          (println (str "  exit " exit ", out " (pr-str out) ", restored " restored ", compiled " compiled))
                                          (when-not (zero? exit) (print err) (flush)))
                                        (when-not ok (str "libcache-def-" (inc i))))))
                                   doall
                                   (remove nil?)
                                   vec)
                    ;; a class file cut short, then whole (test/libcache/fix): the
                    ;; method whose code throws ClassFormatError for it isn't cached,
                    ;; so the run after the file is fixed makes the object
                    fx (str lc "/fix")
                    _ (fs/delete-tree fx)
                    _ (fs/create-dirs (str fx "/classes"))
                    _ (fs/create-dirs (str fx "/whole"))
                    _ (shell (str "java test/gen/ClassFormatGen.java " fx "/classes " fx "/whole"))
                    _ (shell (str "javac -d " fx "/classes test/libcache/fix/CfMain.java"))
                    fix-fails (->> [false false true]
                                   (map-indexed
                                    (fn [i whole?]
                                      (when whole? (fs/copy (str fx "/whole/CfTruncated.class") (str fx "/classes/CfTruncated.class") {:replace-existing true}))
                                      (let [{:keys [out err exit]} (run-limited 300 {:label (str "libcache-fix-" (inc i)) :err :string
                                                                                     :extra-env {"CHAMPACA_NPE_STRICT" "1"}}
                                                                                (jolt-bin) "-M" "-m" "champaca.main" (str fx "/classes") "CfMain")
                                            ok (and (zero? exit) (= out (slurp (str "test/libcache/fix/" (inc i) ".expected"))))]
                                        (println (if ok "PASS" "FAIL") (str "test/libcache/fix run " (inc i)))
                                        (when-not ok
                                          (println (str "  exit " exit ", out " (pr-str out)))
                                          (when-not (zero? exit) (print err) (flush)))
                                        (when-not ok (str "libcache-fix-" (inc i))))))
                                   doall
                                   (remove nil?)
                                   vec)
                    ;; upstream OpenLDK's testsuite/aaa programs (test/aaa, see its
                    ;; README): compiled together into one aaa package, each run from a
                    ;; work dir of its own holding a fresh copy of it (some delete their
                    ;; own class files), its source and a small test.jar, with the
                    ;; arguments upstream's run.exp gives; .expected is the JVM's output
                    _ (fs/delete-tree "target/aaa-classes")
                    _ (fs/delete-tree "target/aaa-work")
                    _ (apply shell "javac -nowarn -Xlint:-removal -d target/aaa-classes" (map str (fs/glob "test/aaa" "*.java")))
                    _ (fs/create-dirs "target/aaa-jar/a")
                    _ (spit "target/aaa-jar/a/x.txt" "x\n")
                    _ (shell "jar cf target/aaa-test.jar -C target/aaa-jar .")
                    aaa-mains (->> (fs/glob "test/aaa" "*.expected")
                                   (map (fn [p] (str/replace (fs/file-name p) ".expected" "")))
                                   sort)
                    ;; none found is a broken checkout or path, not a pass
                    _ (when (empty? aaa-mains) (println "jolt test: no test/aaa/*.expected found") (System/exit 1))
                    deps (str "{:deps {champaca/champaca {:local/root " (pr-str (str (fs/absolutize "."))) "}}}")
                    ;; a path to jolt is made absolute for the work dirs; a bare name is found on PATH
                    jolt (let [j (jolt-bin)] (if (str/includes? j "/") (str (fs/absolutize j)) j))
                    aaa-fails (doall
                               (for [m aaa-mains
                                     :let [w (str "target/aaa-work/" m)
                                           _ (fs/create-dirs w)
                                           _ (fs/copy-tree "target/aaa-classes/aaa" (str w "/aaa"))
                                           _ (fs/copy (str "test/aaa/" m ".java") (str w "/aaa"))
                                           _ (fs/copy "target/aaa-test.jar" (str w "/test.jar"))
                                           {:keys [out exit]} (run-limited 300 {:dir w :label (str "aaa." m) :extra-env {"CHAMPACA_NPE_STRICT" "1"}}
                                                                           jolt "-Sdeps" deps "-M" "-m" "champaca.main"
                                                                           "." (str "aaa." m) "1" "2" "3" "4" "5")
                                           ok (and (zero? exit) (= out (slurp (str "test/aaa/" m ".expected"))))]]
                                 (do (println (if ok "PASS" "FAIL") (str "aaa." m))
                                     (when-not ok (str "aaa." m)))))
                    ;; jolt programs calling Java, each a namespace of clojure.test
                    ;; tests that test/run_example.clj runs in a process of its own
                    ex-fails (doall
                              (for [[n what] examples
                                    :let [{:keys [out exit]} (run-limited 300 {:extra-env {"CHAMPACA_NPE_STRICT" "1"}}
                                                                          (jolt-bin) "-M" "test/run_example.clj" (str "examples/" n ".clj"))
                                          ok (zero? exit)]]
                                (do (println (if ok "PASS" "FAIL") (str "examples/" n ".clj (" what ")"))
                                    (when-not ok (print out) (flush) n))))
                    fails (remove nil? (concat fails jar-fails opt-fails mainsel-fails srclaunch-fails modopts-fails modpath-fails boot-fails save-fails bundle-fails libcache-fails nolines-fails lam-fails edit-fails def-fails fix-fails aaa-fails ex-fails))
                    mains (concat mains ["-jar" "-D -jar" "bad option" "ignored options" "-cp" "-cp star dir" "-cp missing" "-cp -jar" "accepted options" "boot generation" "cache save"] (map (fn [i] (str "libcache-" i)) (range 1 15))
                                  ["libcache-nolines" "libcache-nolines-cache-off" "stackcheck-lines-off"] (map (fn [i] (str "libcache-lam-" i)) (range 1 9))
                                  (map (fn [i] (str "libcache-edit-" i)) (range 1 4))
                                  (map (fn [i] (str "libcache-def-" i)) (range 1 13))
                                  (map (fn [i] (str "libcache-fix-" i)) (range 1 4)) aaa-mains (map first examples))]
                (println (str (- (count mains) (count fails)) "/" (count mains) " passed"))
                (when (seq fails) (System/exit 1)))}
  battery {:doc "The gate before a merge: on a detached worktree of <ref> (HEAD) with a cache of its own, jolt test cold, warm, with CHAMPACA_CACHE=off and with CHAMPACA_BT=1, then jolt libs (jolt battery [ref]; BATTERY_MODES=cold,libs runs a subset, cold first since the cache starts empty); logs and a hang's artifacts stay under target/battery/, and the cache until the next run of another ref"
           :task (let [ref (or (first *command-line-args*) "HEAD")
                       tip (str/trim (:out (shell {:out :string} "git" "rev-parse" "--short" ref)))
                       dir (str (fs/absolutize "target/battery"))
                       wt (str dir "/wt-" tip)
                       cache (str dir "/cache-" tip)
                       envs {"cold" {} "warm" {} "cache-off" {"CHAMPACA_CACHE" "off"} "bt" {"CHAMPACA_BT" "1"} "libs" {}}
                       modes (if-let [m (System/getenv "BATTERY_MODES")] (str/split m (re-pattern ",")) ["cold" "warm" "cache-off" "bt" "libs"])
                       _ (when (or (empty? modes) (some (fn [m] (not (contains? envs m))) modes))
                           (println "jolt battery: BATTERY_MODES names modes among" (str/join ", " (keys envs)) "; got" (pr-str modes))
                           (System/exit 2))
                       ;; the modes' environment: this process's, less the two variables a mode
                       ;; sets for itself, so an outer CHAMPACA_BT=1 doesn't make every mode bt
                       base-env (into {} (remove (fn [[k _]] (contains? #{"CHAMPACA_CACHE" "CHAMPACA_BT" "CHAMPACA_CACHE_DIR"} k)) (System/getenv)))
                       _ (fs/create-dirs dir)
                       ;; earlier refs' caches (a few hundred MB each) and worktrees left by
                       ;; runs that died go first; this ref's cache goes too, to start cold.
                       ;; The logs and a hang's artifacts stay: small, and what a failure
                       ;; is read from
                       _ (doseq [d (fs/list-dir dir)
                                 :let [n (fs/file-name d)]]
                           ;; a run killed in jolt test's test/bundlecache rows leaves
                           ;; read-only directories (r-x), which no delete gets through
                           (when (or (str/starts-with? n "wt-") (str/starts-with? n "cache-"))
                             (shell {:continue true :out :string :err :string} "chmod" "-R" "u+w" (str d)))
                           (when (str/starts-with? n "wt-")
                             (shell {:continue true :out :string :err :string} "git" "worktree" "remove" "--force" (str d)))
                           (when (or (str/starts-with? n "wt-") (str/starts-with? n "cache-"))
                             (fs/delete-tree d)))
                       ;; a registration whose directory is already gone (a run that died
                       ;; after something else deleted its worktree) only prune clears
                       _ (shell "git" "worktree" "prune")
                       _ (shell "git" "worktree" "add" "-q" "--detach" wt ref)
                       _ (println "tip:" tip "worktree:" wt)
                       ;; each mode's whole output goes to its log (stdout and stderr merged by
                       ;; the process); the summary is its FAIL lines, its count and its exit
                       ;; status, so a run that dies before its count still says so
                       [results hangs]
                       (try
                         (let [results (doall
                                        (for [mode modes]
                                          (let [log (str dir "/" tip "-" mode ".log")
                                                _ (println (str "== " mode))
                                                st (with-open [o (io/output-stream log)]
                                                     (:exit (shell {:dir wt :out o :err :out :continue true
                                                                    :env (merge base-env (get envs mode) {"CHAMPACA_CACHE_DIR" cache})}
                                                                   runner (if (= mode "libs") "libs" "test"))))
                                                lines (str/split-lines (slurp log))
                                                fails (filter (fn [l] (or (str/starts-with? l "FAIL") (str/starts-with? l "DIFF"))) lines)
                                                count-line (last (filter (fn [l] (or (str/ends-with? l " passed") (str/includes? l " matched"))) lines))]
                                            (doseq [l fails] (println l))
                                            (println (or count-line "   (no count: the run died)"))
                                            (println (str "   exit " st ", log " log))
                                            (and (zero? st) (empty? fails) (some? count-line)))))
                               h (str wt "/target/hangs")
                               hangs (if (fs/exists? h) (count (fs/list-dir h)) 0)]
                           ;; a hang's partial output and stack sample outlive the worktree
                           (when (pos? hangs)
                             (fs/delete-tree (str dir "/" tip "-hangs"))
                             (fs/move h (str dir "/" tip "-hangs"))
                             (println "== hangs:" hangs "kept under" (str dir "/" tip "-hangs")))
                           [results hangs])
                         (finally
                           (let [r (shell {:continue true :out :string :err :string} "git" "worktree" "remove" "--force" wt)]
                             (when-not (zero? (:exit r)) (println "jolt battery: couldn't remove the worktree" wt (str/trim (:err r)))))))
                       ok (and (every? true? results) (zero? hangs))]
                   (println (str "== hangs: " hangs))
                   (println (if ok "battery green" "battery RED"))
                   (System/exit (if ok 0 1)))}
  bundle {:doc "An app bundle that runs with no JDK installed: a jlink runtime without the JVM, champaca built by jolt, the classpath, a launcher and a warmed cache that moves with the directory (jolt bundle -o OUT -cp CP -m MAIN [--train ARGS...], or --jolt NS --project DIR; tools/bundle.clj)"
          :task (do (load-file "tools/bundle.clj")
                    (apply (resolve 'bundle/-main) (str (fs/cwd)) (jolt-bin) *command-line-args*))}
  prof {:doc "Where a process's time goes: boot, run <Main> with a sampling profiler on its thread, print the hot Java frames (jolt prof <classpath> <Main> [args...]; PROF_US=2000; tools/prof.clj)"
        :task (let [args *command-line-args*]
                (when (< (count args) 2) (println "usage: jolt prof <classpath> <Main> [args...]") (System/exit 2))
                (apply shell (jolt-bin) "-M" "tools/prof.clj" args))}
  heap {:doc "Where a process's memory goes: boot, run <Main>, measure the live heap (jolt heap <classpath> <Main> [types|roots|java] [args...]; tools/heap.clj)"
        :task (let [args *command-line-args*]
                (when (< (count args) 2) (println "usage: jolt heap <classpath> <Main> [types|roots|java] [args...]") (System/exit 2))
                (apply shell (jolt-bin) "-M" "tools/heap.clj" args))}
  libs {:doc "Run the real libraries in test/libs on the JVM and through champaca, compare outputs (jolt libs Gua Yml runs some; --allow-skip lets missing jars pass)"
        :task (let [allow-skip (some (fn [a] (= a "--allow-skip")) *command-line-args*)
                    only (set (remove (fn [a] (= a "--allow-skip")) *command-line-args*))
                    libs (:libs (edn/read-string (slurp "test/libs/libs.edn")))
                    unknown (remove (set (map :main libs)) only)
                    _ (when (seq unknown)
                        (println "no such probe:" (str/join ", " unknown) "(test/libs/libs.edn has" (str (str/join ", " (map :main libs)) ")"))
                        (System/exit 1))
                    tail (fn [s] (str/join "\n    " (take-last 5 (str/split-lines s))))
                    results
                    (doall
                     (for [{:keys [main jars stderr]} libs
                           :when (or (empty? only) (contains? only main))
                           :let [missing (remove (fn [[c _]] (fs/exists? (m2-jar c))) jars)
                                 bad (when (empty? missing)
                                       (remove (fn [[c sha]] (= sha (sha1-hex (m2-jar c)))) jars))]]
                       (cond
                         (seq missing)
                         (do (println "SKIP" main "(not in ~/.m2:" (str (str/join ", " (map first missing)) "; jolt libs:fetch gets them)"))
                             :skip)
                         (seq bad)
                         (do (println "FAIL" main "(SHA-1 is not the pinned one:" (str (str/join ", " (map (fn [[c _]] (m2-jar c)) bad)) ")"))
                             :fail)
                         :else
                         (let [out (str "target/libs/" main)
                               cp (str/join ":" (map (fn [[c _]] (m2-jar c)) jars))
                               _ (fs/delete-tree out)
                               _ (fs/create-dirs out)
                               jc (shell {:err :string :continue true} "javac -nowarn -cp" cp "-d" out (str "test/libs/" main ".java"))]
                           (if-not (zero? (:exit jc))
                             (do (println "FAIL" main "(javac)") (println (str "    " (tail (:err jc)))) :fail)
                             (let [run-cp (str out ":" cp)
                                   jvm (shell {:out :string :err :string :continue true} "java -cp" run-cp main)
                                   ;; a fresh cache each time, so the run is a cold one
                                   cache (fs/create-temp-dir)
                                   ch (try (shell {:out :string :err :string :continue true
                                                   :extra-env {"CHAMPACA_CACHE_DIR" (str cache) "CHAMPACA_NPE_STRICT" "1"}}
                                                  (jolt-bin) "-M" "-m" "champaca.main" run-cp main)
                                           (finally (fs/delete-tree cache)))
                                   exits-ok (and (zero? (:exit jvm)) (zero? (:exit ch)))
                                   same-out (= (:out jvm) (:out ch))
                                   same-err (or (not stderr) (= (:err jvm) (:err ch)))
                                   ok (and exits-ok same-out same-err)]
                               (println (if ok "MATCH" "DIFF ") main)
                               (cond
                                 ok nil
                                 (not exits-ok)
                                 (do (println (str "  exit jvm " (:exit jvm) ", champaca " (:exit ch)))
                                     (when-not (zero? (:exit jvm)) (println (str "  jvm stderr:\n    " (tail (:err jvm)))))
                                     (when-not (zero? (:exit ch)) (println (str "  champaca stderr:\n    " (tail (:err ch))))))
                                 :else
                                 (let [which (if same-out "stderr" "stdout")
                                       a (str/split-lines (if same-out (:err jvm) (:out jvm)))
                                       b (str/split-lines (if same-out (:err ch) (:out ch)))
                                       i (or (first (filter (fn [i] (not= (get a i) (get b i))) (range (max (count a) (count b))))) 0)]
                                   (println (str "  first difference, " which " line " (inc i) ":"))
                                   (println "  jvm:     " (get a i))
                                   (println "  champaca:" (get b i))))
                               (if ok :match :diff)))))))
                    ran (remove (fn [r] (= r :skip)) results)
                    skipped (- (count results) (count ran))
                    matched (count (filter (fn [r] (= r :match)) ran))]
                (println (str matched "/" (count ran) " matched"
                              (when (pos? skipped) (str ", " skipped " skipped, NOT verified"))))
                (when (or (not= matched (count ran)) (empty? ran) (and (pos? skipped) (not allow-skip)))
                  (System/exit 1)))}
  linux:image {:doc "Build ci/linux's image for arm64 or amd64 (default: this machine's), fetching its JDK into ci/linux/cache first"
               :task (linux-image! (linux-arch (first *command-line-args*)))}
  linux {:doc "Run the tests and the libraries (test, libs) with the pinned jolt on Linux (arm64 or amd64, default this machine's) in ci/linux's image (CHAMPACA_LINUX_RUN replaces that command, with $J the pinned jolt, e.g. \"BATTERY_MODES=bt $J battery\"); jars come from ~/.m2, read-only"
         :task (let [arch (linux-arch (first *command-line-args*))]
                 (linux-image! arch)
                 (shell runner "libs:fetch")
                 (shell "docker run --rm --platform" (str "linux/" arch)
                        "-v" (str (fs/cwd) ":/champaca")
                        ;; the jolt build and champaca's caches persist per architecture,
                        ;; in a volume, or in CHAMPACA_LINUX_HOME's directory (CI caches
                        ;; the jolt binary from there)
                        "-v" (str (or (some-> (System/getenv "CHAMPACA_LINUX_HOME") not-empty
                                              (doto (fs/create-dirs)) fs/absolutize str)
                                      (str "champaca-linux-" arch))
                                  ":/root")
                        "-v" (str (System/getenv "HOME") "/.m2:/root/.m2:ro")
                        (str "champaca-linux:" arch)
                        ;; no task runner in the image: build-jolt.sh builds the pinned
                        ;; jolt and prints its path, and that jolt runs the tasks ($J)
                        "sh" "-c" (str "J=$(sh tools/build-jolt.sh) && "
                                       (or (not-empty (System/getenv "CHAMPACA_LINUX_RUN"))
                                           "\"$J\" test && \"$J\" libs"))))}
  libs:fetch {:doc "Download the test/libs jars missing from ~/.m2 from Maven Central, each kept only when its SHA-1 is the pinned one"
              :task (doseq [{:keys [jars]} (:libs (edn/read-string (slurp "test/libs/libs.edn")))
                            [c sha] jars
                            :let [f (m2-jar c)]
                            :when (not (fs/exists? f))]
                      (let [part (str f ".part")]
                        (fs/create-dirs (fs/parent f))
                        (try
                          (shell "curl -fsSL --retry 2 --connect-timeout 15 --max-time 300 -o" part
                                 (str "https://repo1.maven.org/maven2/" (m2-path c)))
                          (let [got (sha1-hex part)]
                            (if (= got sha)
                              (do (fs/move part f {:replace-existing true}) (println "fetched" c))
                              (do (println "REFUSED" c ": SHA-1" got "is not the pinned" sha)
                                  ;; exit skips finally
                                  (fs/delete-if-exists part)
                                  (System/exit 1))))
                          (finally (fs/delete-if-exists part)))))}
  bench {:doc "Upstream OpenLDK's startup benchmarks: build and time Spring Boot or Quarkus on HotSpot and through champaca (jolt bench spring-boot [build|bench|all]); see bench/README.md"
         :task (do (load-file "bench/bench.clj")
                   ((resolve (symbol "bench" "main")) (jolt-bin) *command-line-args*))}
  ;; Report only: findings never fail these. metrics.cli exits non-zero
  ;; only on bad usage or a missing directory, and that exit passes through.
  metrics {:doc "jolt-metrics report over the repo (Markdown; findings never fail it). Extra args go to metrics.cli: an output file (its extension picks the format), --top N, --no-git, --exclude GLOB"
           :task (apply shell (jolt-bin) "-M:metrics" "." *command-line-args*)}
  metrics:edn {:doc "jolt-metrics findings as EDN (findings never fail it). Extra args as for metrics"
               :task (apply shell (jolt-bin) "-M:metrics" "." "--format" "edn" *command-line-args*)}
  metrics:json {:doc "jolt-metrics' lean JSON report, for tools (findings never fail it). Extra args as for metrics"
                :task (apply shell (jolt-bin) "-M:metrics" "." "--format" "json" *command-line-args*)}
  metrics:html {:doc "jolt-metrics as one self-contained HTML page, target/metrics.html unless a file comes first (findings never fail it). Extra args as for metrics"
                :task (let [args *command-line-args*
                            out? (and (seq args) (not (str/starts-with? (first args) "-")))
                            args (if out? args (cons "target/metrics.html" args))]
                        (some-> (fs/parent (first args)) fs/create-dirs)
                        (apply shell (jolt-bin) "-M:metrics" "." "--format" "html" args))}
  examples {:doc "List the examples/*.clj programs that jolt example runs"
            :task (doseq [[n what] examples]
                    (println (format "  %-16s %s" n what)))}
  example {:doc "Run one examples/*.clj file's tests on the jolt jolt test picks (jolt example interop), building target/lib.jar first when it's missing or stale"
           :task (let [arg (first *command-line-args*)
                       n (when arg (fs/strip-ext (fs/file-name arg)))]
                   (when-not (some (fn [[e _]] (= e n)) examples)
                     (println (if arg (str "no such example: " arg) "usage: jolt example <name>, one of:"))
                     (run 'examples)
                     (System/exit 1))
                   (when (lib-jar-stale?) (lib-jar!))
                   (System/exit (:exit (shell {:continue true} (jolt-bin) "-M" "test/run_example.clj" (str "examples/" n ".clj")))))}
  nrepl {:doc "Start jolt's nREPL server here for an editor (CIDER, Calva); a free port by default, written to .nrepl-port (jolt nrepl 7890 or CHAMPACA_NREPL_PORT=7890 asks for one, refused when busy)"
         :task (let [given (or (first *command-line-args*) (System/getenv "CHAMPACA_NREPL_PORT"))
                     port (if given (parse-long given) 0)
                     pf ".nrepl-port"
                     running (port-file-port pf)]
                 (when-not (and port (<= 0 port 65535))
                   (println (str "jolt nrepl: the port is a number from 0 (any free one) to 65535, not " given))
                   (System/exit 1))
                 (when (and running (port-answers? running))
                   (println (str "jolt nrepl: a server already answers on port " running " (.nrepl-port); connect to it, or stop it first"))
                   (System/exit 1))
                 ;; left by a server that was killed
                 (fs/delete-if-exists pf)
                 (when (lib-jar-stale?) (lib-jar!))
                 (println ";; Emacs: M-x cider-connect-clj, host localhost, and CIDER offers the port in .nrepl-port")
                 (println ";; then: (require '[champaca.api :as ldk]) (ldk/init! {:classpath [\"target/lib.jar\"]})")
                 (let [exit (:exit (shell {:continue true} (jolt-bin) "nrepl-server" (str port)))]
                   ;; jolt removes its port file on ^C; a server killed outright leaves it
                   (when-let [p (port-file-port pf)]
                     (when-not (port-answers? p) (fs/delete-if-exists pf)))
                   (System/exit exit)))}
  site:build {:doc "Build the documentation site into _site/ (needs a docs-engine checkout)"
              :task (site-task "build")}
  ;; No port given: scan from 3000 for a free one. A port you name is honoured
  ;; strictly and refused when busy, never swapped for another.
  site:serve {:doc "Build the docs site and serve it locally; first free port from 3000, or site:serve PORT (refused if busy)"
              :task (let [requested (first *command-line-args*)
                          port (when requested (parse-long requested))]
                      (when (and requested (not (and port (<= 1 port 65535))))
                        (println (str "jolt site:serve: the port is a number from 1 to 65535, not " requested))
                        (System/exit 1))
                      (if port
                        (if (can-bind? port)
                          (site-task "serve" (str port))
                          (do (println (str "jolt site:serve: port " port " is busy; pick another, or drop the argument to scan from 3000"))
                              (System/exit 1)))
                        (if-let [p (free-port 3000 100)]
                          (do (println (str "jolt site:serve: using free port " p))
                              (site-task "serve" (str p)))
                          (do (println "jolt site:serve: no free port in 3000..3100")
                              (System/exit 1)))))}
  site:clean {:doc "Delete the _site/ build output"
              :task (site-task "clean")}}}
