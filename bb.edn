{:tasks
 {:requires ([babashka.fs :as fs] [babashka.process :as process] [clojure.string :as str] [clojure.edn :as edn])
  :init (do
          ;; deps.edn :champaca/jolt pins an upstream jolt commit; `bb jolt` builds
          ;; it to ~/.cache/champaca/jolt/<sha>/jolt from a jolt checkout
          ;; ($JOLT_SRC, default ~/dev/jolt) through a detached worktree.
          (def jolt-pin (:champaca/jolt (edn/read-string (slurp "deps.edn"))))
          (def jolt-dir (str (System/getenv "HOME") "/.cache/champaca/jolt/" (subs (:git/sha jolt-pin) 0 8)))
          (def jolt-pinned (str jolt-dir "/jolt"))
          ;; $JOLT wins, then the pinned build, then jolt on PATH
          (defn jolt-bin []
            (or (System/getenv "JOLT") (when (fs/executable? jolt-pinned) jolt-pinned) "jolt"))
          ;; a command with a time limit, so a test that hangs fails instead.
          ;; A hang leaves its output so far, and on macOS a native stack
          ;; sample, in target/hangs/<program>-<ms>/.
          (defn run-limited [secs opts & cmd]
            (let [outf (str (fs/create-temp-file {:prefix "champaca-out-"}))
                  proc (apply process/process (merge {:out (fs/file outf) :err :inherit :in :inherit} opts) cmd)
                  r (deref proc (* 1000 secs) :timed-out)]
              (try
                (if (= r :timed-out)
                  (let [d (str "target/hangs/" (fs/file-name (last cmd)) "-" (System/currentTimeMillis))]
                    (fs/create-dirs d)
                    (when (fs/which "sample")
                      (shell {:continue true :out (str d "/sample.txt") :err :string} "sample" (str (.pid (:proc proc))) "5"))
                    (fs/copy outf (str d "/partial.out"))
                    (process/destroy-tree proc)
                    (println (str "timed out after " secs " s; output so far and a stack sample in " d))
                    {:out "" :exit 124})
                  (assoc r :out (slurp outf)))
                (finally (fs/delete-if-exists outf)))))
          ;; test/libs: a Maven coordinate's path in a repository, and a file's SHA-1
          (defn m2-path [coord]
            (let [[g a v] (str/split coord (re-pattern ":"))]
              (str (str/replace g "." "/") "/" a "/" v "/" a "-" v ".jar")))
          (defn m2-jar [coord] (str (System/getenv "HOME") "/.m2/repository/" (m2-path coord)))
          ;; ci/linux: the image's architecture, and building it
          (defn linux-arch [given]
            (let [arch (or given (if (re-find (re-pattern "arm64|aarch64") (str/trim (:out (shell {:out :string} "uname -m")))) "arm64" "amd64"))]
              (when-not (contains? #{"arm64" "amd64"} arch)
                (println (str "bb linux: the architecture is arm64 or amd64, not " arch))
                (System/exit 1))
              arch))
          ;; the pinned OpenJDK 25.0.2 per architecture: the one place its checksums live
          (defn linux-image! [arch]
            (let [[a sha] (case arch
                            "arm64" ["aarch64" "671208d205e70c9805da45a483f670d49dd64654990a7b7223ccffb2abb070dd"]
                            "amd64" ["x64" "555ce0821e4fe175ea50d54518cd6fbece9663c1998de529bc6ce429534457df"])
                  file (str "openjdk-25.0.2_linux-" a "_bin.tar.gz")
                  f (str "ci/linux/cache/" file)]
              (when-not (fs/exists? f)
                (fs/create-dirs "ci/linux/cache")
                ;; some proxies refuse download.java.net; a direct connection works
                (shell {:env (apply dissoc (into {} (System/getenv)) ["HTTPS_PROXY" "https_proxy" "HTTP_PROXY" "http_proxy"])}
                       "curl -fsSL --retry 2 -o" (str f ".part")
                       (str "https://download.java.net/java/GA/jdk25.0.2/b1e0dfa218384cb9959bdcb897162d4e/10/GPL/openjdk-25.0.2_linux-" a "_bin.tar.gz"))
                (fs/move (str f ".part") f {:replace-existing true}))
              (let [md (java.security.MessageDigest/getInstance "SHA-256")
                    got (apply str (map (fn [b] (format "%02x" (bit-and b 0xff))) (.digest md (fs/read-all-bytes f))))]
                (when-not (= got sha)
                  (fs/delete f)
                  (println "REFUSED" f ": SHA-256" got "is not the pinned" sha)
                  (System/exit 1)))
              (shell "docker build --platform" (str "linux/" arch) "--build-arg" (str "JDK_FILE=" file)
                     "--build-arg" (str "JDK_SHA256=" sha) "-t" (str "champaca-linux:" arch) "ci/linux")))
          (defn sha1-hex [f]
            (let [md (java.security.MessageDigest/getInstance "SHA-1")]
              (apply str (map (fn [b] (format "%02x" (bit-and b 0xff))) (.digest md (fs/read-all-bytes f)))))))
  jolt {:doc "Build the jolt commit pinned in deps.edn (:champaca/jolt) to ~/.cache/champaca/jolt/<sha>/jolt"
        :task (let [sha (:git/sha jolt-pin)
                    src (or (System/getenv "JOLT_SRC") (str (System/getenv "HOME") "/dev/jolt"))
                    wt (str jolt-dir "/src")]
                (if (fs/executable? jolt-pinned)
                  (println "already built:" jolt-pinned)
                  (do
                    (when-not (fs/exists? src)
                      (shell "git clone" (:git/url jolt-pin) src))
                    (when-not (zero? (:exit (shell {:continue true :err :string} "git -C" src "cat-file" "-e" (str sha "^{commit}"))))
                      (shell "git -C" src "fetch" (:git/url jolt-pin) sha))
                    (when-not (fs/exists? wt)
                      (shell "git -C" src "worktree" "add" "--detach" wt sha))
                    ;; borrow the checkout's submodule objects when it has them
                    (doseq [m (str/split-lines (:out (shell {:dir wt :out :string} "git config -f .gitmodules --get-regexp path")))
                            :let [p (second (str/split m (re-pattern " ")))
                                  ref (str src "/" p)]]
                      (if (fs/exists? (str ref "/.git"))
                        (shell {:dir wt} "git submodule update --init --reference" ref p)
                        (shell {:dir wt} "git submodule update --init" p)))
                    (shell {:dir wt} "make build")
                    (fs/copy (str wt "/target/release/jolt") jolt-pinned {:replace-existing true})
                    (shell jolt-pinned "--version"))))}
  test {:doc "javac test/java/*.java, run each main class through the JIT, diff against <Name>.expected"
        :task (let [_ (println "jolt:" (jolt-bin) (str/trim (:out (shell {:out :string} (jolt-bin) "--version"))))
                    _ (shell "mkdir -p target/classes target/lib-classes")
                    ;; test/jar is packed into target/lib.jar, so its classes reach
                    ;; the runtime only from a jar on the classpath
                    _ (apply shell "javac -d target/lib-classes" (map str (fs/glob "test/jar" "**.java")))
                    ;; and its other files: a service registration, a properties file
                    _ (doseq [f (fs/glob "test/jar" "**")
                              :when (and (fs/regular-file? f) (not (str/ends-with? (str f) ".java")))
                              :let [to (fs/path "target/lib-classes" (str (fs/relativize "test/jar" f)))]]
                        (fs/create-dirs (fs/parent to))
                        (fs/copy f to {:replace-existing true}))
                    ;; with a manifest of its own: a package section, a wrapped value
                    _ (shell "jar cfm target/lib.jar test/jar.mf -C target/lib-classes .")
                    ;; a second jar sharing one package with the first (PackageCheck)
                    _ (shell "mkdir -p target/lib2-classes")
                    _ (apply shell "javac -d target/lib2-classes" (map str (fs/glob "test/jar2" "**.java")))
                    _ (shell "jar cfm target/lib2.jar test/jar2.mf -C target/lib2-classes .")
                    srcs (map str (fs/glob "test/java" "*.java"))
                    _ (apply shell "javac -parameters -cp target/lib.jar:target/lib2.jar -d target/classes" srcs)
                    ;; IndyCheck calls bootstraps of its own, which javac can't emit
                    _ (shell "java test/gen/IndyCheckGen.java target/classes")
                    ;; DefaultConflictCheck's classes conflict only at run time, which javac refuses
                    _ (shell "java test/gen/DefaultConflictGen.java target/classes")
                    ;; BlockingIoCheck's FIFO
                    _ (fs/delete-if-exists "target/blocking-io.fifo")
                    _ (shell "mkfifo target/blocking-io.fifo")
                    mains (->> (fs/glob "test/java" "*.expected")
                               (map (fn [p] (str/replace (fs/file-name p) ".expected" "")))
                               sort)
                    fails (doall
                           (for [m mains
                                 :let [stdin (str "test/java/" m ".stdin")
                                       {:keys [out exit]} (run-limited 300 (cond-> {:extra-env {"CHAMPACA_NPE_STRICT" "1" "CHAMPACA_TEST_VAR" "a=b=c"}}
                                                                             (fs/exists? stdin) (assoc :in (fs/file stdin)))
                                                                       (jolt-bin) "-M" "-m" "champaca.main" "target/classes:target/lib.jar:target/lib2.jar" m)
                                       ok (and (zero? exit) (= out (slurp (str "test/java/" m ".expected"))))]]
                             (do (println (if ok "PASS" "FAIL") m) (when-not ok m))))
                    ;; jolt programs calling Java, checked against expected output
                    examples [["interop" "jolt calling Java"] ["dynamic" "descriptor-free calls"]
                              ["varargs" "varargs and vectors as arrays"]
                              ["jars" "a jar and other JDK modules"]
                              ["collections" "jolt collections as java.util and back"]
                              ["callsite" "the call-site cache"]
                              ["jolt-after-init" "jolt itself still works after init!"]
                              ["threads" "Java threads started from jolt"]
                              ["files" "files and MessageDigest from jolt"]
                              ["fields" "Java fields read and written from jolt"]]
                    ex-fails (doall
                              (for [[n what] examples
                                    :let [{:keys [out exit]} (run-limited 300 {:extra-env {"CHAMPACA_NPE_STRICT" "1"}}
                                                                          (jolt-bin) "-M" (str "examples/" n ".clj"))
                                          ok (and (zero? exit) (= out (slurp (str "examples/" n ".expected"))))]]
                                (do (println (if ok "PASS" "FAIL") (str "examples/" n ".clj (" what ")"))
                                    (when-not ok n))))
                    fails (remove nil? (concat fails ex-fails))
                    mains (concat mains (map first examples))]
                (println (str (- (count mains) (count fails)) "/" (count mains) " passed"))
                (when (seq fails) (System/exit 1)))}
  libs {:doc "Run the real libraries in test/libs on the JVM and through champaca, compare outputs (bb libs Gua Yml runs some; --allow-skip lets missing jars pass)"
        :task (let [allow-skip (some (fn [a] (= a "--allow-skip")) *command-line-args*)
                    only (set (remove (fn [a] (= a "--allow-skip")) *command-line-args*))
                    libs (:libs (edn/read-string (slurp "test/libs/libs.edn")))
                    unknown (remove (set (map :main libs)) only)
                    _ (when (seq unknown)
                        (println "no such probe:" (str/join ", " unknown) "(test/libs/libs.edn has" (str (str/join ", " (map :main libs)) ")"))
                        (System/exit 1))
                    tail (fn [s] (str/join "\n    " (take-last 5 (str/split-lines s))))
                    results
                    (doall
                     (for [{:keys [main jars stderr]} libs
                           :when (or (empty? only) (contains? only main))
                           :let [missing (remove (fn [[c _]] (fs/exists? (m2-jar c))) jars)
                                 bad (when (empty? missing)
                                       (remove (fn [[c sha]] (= sha (sha1-hex (m2-jar c)))) jars))]]
                       (cond
                         (seq missing)
                         (do (println "SKIP" main "(not in ~/.m2:" (str (str/join ", " (map first missing)) "; bb libs:fetch gets them)"))
                             :skip)
                         (seq bad)
                         (do (println "FAIL" main "(SHA-1 is not the pinned one:" (str (str/join ", " (map (fn [[c _]] (m2-jar c)) bad)) ")"))
                             :fail)
                         :else
                         (let [out (str "target/libs/" main)
                               cp (str/join ":" (map (fn [[c _]] (m2-jar c)) jars))
                               _ (fs/delete-tree out)
                               _ (fs/create-dirs out)
                               jc (shell {:err :string :continue true} "javac -nowarn -cp" cp "-d" out (str "test/libs/" main ".java"))]
                           (if-not (zero? (:exit jc))
                             (do (println "FAIL" main "(javac)") (println (str "    " (tail (:err jc)))) :fail)
                             (let [run-cp (str out ":" cp)
                                   jvm (shell {:out :string :err :string :continue true} "java -cp" run-cp main)
                                   ;; a fresh cache each time, so the run is a cold one
                                   cache (fs/create-temp-dir)
                                   ch (try (shell {:out :string :err :string :continue true
                                                   :extra-env {"CHAMPACA_CACHE_DIR" (str cache) "CHAMPACA_NPE_STRICT" "1"}}
                                                  (jolt-bin) "-M" "-m" "champaca.main" run-cp main)
                                           (finally (fs/delete-tree cache)))
                                   exits-ok (and (zero? (:exit jvm)) (zero? (:exit ch)))
                                   same-out (= (:out jvm) (:out ch))
                                   same-err (or (not stderr) (= (:err jvm) (:err ch)))
                                   ok (and exits-ok same-out same-err)]
                               (println (if ok "MATCH" "DIFF ") main)
                               (cond
                                 ok nil
                                 (not exits-ok)
                                 (do (println (str "  exit jvm " (:exit jvm) ", champaca " (:exit ch)))
                                     (when-not (zero? (:exit jvm)) (println (str "  jvm stderr:\n    " (tail (:err jvm)))))
                                     (when-not (zero? (:exit ch)) (println (str "  champaca stderr:\n    " (tail (:err ch))))))
                                 :else
                                 (let [which (if same-out "stderr" "stdout")
                                       a (str/split-lines (if same-out (:err jvm) (:out jvm)))
                                       b (str/split-lines (if same-out (:err ch) (:out ch)))
                                       i (or (first (filter (fn [i] (not= (get a i) (get b i))) (range (max (count a) (count b))))) 0)]
                                   (println (str "  first difference, " which " line " (inc i) ":"))
                                   (println "  jvm:     " (get a i))
                                   (println "  champaca:" (get b i))))
                               (if ok :match :diff)))))))
                    ran (remove (fn [r] (= r :skip)) results)
                    skipped (- (count results) (count ran))
                    matched (count (filter (fn [r] (= r :match)) ran))]
                (println (str matched "/" (count ran) " matched"
                              (when (pos? skipped) (str ", " skipped " skipped, NOT verified"))))
                (when (or (not= matched (count ran)) (empty? ran) (and (pos? skipped) (not allow-skip)))
                  (System/exit 1)))}
  linux:image {:doc "Build ci/linux's image for arm64 or amd64 (default: this machine's), fetching its JDK into ci/linux/cache first"
               :task (linux-image! (linux-arch (first *command-line-args*)))}
  linux {:doc "Run bb test and bb libs on Linux (arm64 or amd64, default this machine's) in ci/linux's image; jars come from ~/.m2, read-only"
         :task (let [arch (linux-arch (first *command-line-args*))]
                 (linux-image! arch)
                 (shell "bb libs:fetch")
                 (shell "docker run --rm --platform" (str "linux/" arch)
                        "-v" (str (fs/cwd) ":/champaca")
                        ;; the jolt build and champaca's caches persist per architecture
                        "-v" (str "champaca-linux-" arch ":/root")
                        "-v" (str (System/getenv "HOME") "/.m2:/root/.m2:ro")
                        (str "champaca-linux:" arch)
                        "sh" "-c" "bb jolt && bb test && bb libs"))}
  libs:fetch {:doc "Download the test/libs jars missing from ~/.m2 from Maven Central, each kept only when its SHA-1 is the pinned one"
              :task (doseq [{:keys [jars]} (:libs (edn/read-string (slurp "test/libs/libs.edn")))
                            [c sha] jars
                            :let [f (m2-jar c)]
                            :when (not (fs/exists? f))]
                      (let [part (str f ".part")]
                        (fs/create-dirs (fs/parent f))
                        (try
                          (shell "curl -fsSL --retry 2 --connect-timeout 15 --max-time 300 -o" part
                                 (str "https://repo1.maven.org/maven2/" (m2-path c)))
                          (let [got (sha1-hex part)]
                            (if (= got sha)
                              (do (fs/move part f {:replace-existing true}) (println "fetched" c))
                              (do (println "REFUSED" c ": SHA-1" got "is not the pinned" sha)
                                  ;; exit skips finally
                                  (fs/delete-if-exists part)
                                  (System/exit 1))))
                          (finally (fs/delete-if-exists part)))))}}}
